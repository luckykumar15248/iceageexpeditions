# Copy to .env (local) or set in the server's environment. Never commit real values.
# NEXT_PUBLIC_* values are inlined into the browser bundle at `next build`; change them, then rebuild.

# --- Database ------------------------------------------------------------------
# MySQL connection used by Prisma (lib/db.ts). On the VPS use 127.0.0.1, not localhost.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/iceageexpeditions"

# --- Site ----------------------------------------------------------------------
# Public origin used for canonical URLs, sitemap, and Open Graph tags. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://YOUR_DOMAIN"

# --- Ops console ---------------------------------------------------------------
# HMAC secret for staff session cookies. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OPS_SESSION_SECRET=""
# First-login bootstrap account. Remove both after creating real staff users.
OPS_BOOTSTRAP_EMAIL=""
OPS_BOOTSTRAP_PASSWORD=""

# --- Blog comments ---------------------------------------------------------------
# Optional HMAC salt for hashing commenter IPs (rate limiting and flood flags).
# Falls back to OPS_SESSION_SECRET when empty. Raw IPs are never stored.
COMMENT_IP_SALT=""

# --- Media uploads -------------------------------------------------------------
# Persistent directory behind /uploads/*. Leave empty locally (falls back to public/uploads).
# Production: MEDIA_ROOT="/var/lib/iceageexpeditions/uploads"  (see deploy/nginx/iceageexpeditions.conf)
MEDIA_ROOT=""

# --- Google reCAPTCHA v2 ("I'm not a robot" checkbox) ---------------------------
# Protects the public enquiry and booking forms. Create keys at
# https://www.google.com/recaptcha/admin/create -> type "Challenge (v2)" -> "I'm not a robot" Checkbox.
# Add every domain that serves the forms (apex and www; add localhost for local testing).
#
# Site key: public, rendered in the browser. Requires a rebuild when changed.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# Secret key: server only. Leave both empty to disable the check (local dev only).
RECAPTCHA_SECRET_KEY=""
#
# Google's published test keys always pass and show a warning banner in the widget.
# Use them only on localhost:
#   NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"
#   RECAPTCHA_SECRET_KEY="6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe"
